<mxfile host="app.diagrams.net"><diagram name="Before - manual loan intake"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="470"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="BEFORE: manual loan intake" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="25" width="700" height="36" as="geometry"/></mxCell><mxCell id="s0" value="Client sends details&lt;br&gt;by WhatsApp / email" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="p0" value="Details scattered&lt;br&gt;across chats, often&lt;br&gt;incomplete" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="170" height="80" as="geometry"/></mxCell><mxCell id="s1" value="Assistant retypes&lt;br&gt;details into a&lt;br&gt;spreadsheet" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="p1" value="Typing errors,&lt;br&gt;slow, repeated&lt;br&gt;for every case" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="270" y="290" width="170" height="80" as="geometry"/></mxCell><mxCell id="s2" value="Assistant checks&lt;br&gt;documents by eye" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="190" height="90" as="geometry"/></mxCell><mxCell id="p2" value="Missing documents&lt;br&gt;easily overlooked" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor